{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      // Zod schemas + AppError, copied from the frontend by `npm run sync:shared`.
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src", "prisma", "tests", "prisma.config.ts", "vitest.config.ts", "generated"]
}
